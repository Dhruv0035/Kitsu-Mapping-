{
  "functions": {
    "api/index.py": {
      "includeFiles": "api/overrides.json"
    }
  },
  "rewrites": [
    {
      "source": "/stream/(.*)",
      "destination": "/api/index.py/stream/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py/health"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
