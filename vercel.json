{
  "functions": {
    "api/index.py": {
      "includeFiles": "api/overrides.json"
    }
  },
  "routes": [
    {
      "src": "/stream/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
